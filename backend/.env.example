# Copy to `.env` and fill in. NEVER commit the real `.env`.

# --- App ---
PORT=3000
NODE_ENV=development

# --- Database (PostgreSQL) ---
# prisma reads DATABASE_URL for migrate/generate/query.
DATABASE_URL="postgresql://artlavka:artlavka@localhost:5432/artlavka?schema=public"

# --- JWT (min 16 chars each; use long random strings in prod) ---
JWT_ACCESS_SECRET="change-me-access-secret-please"
JWT_REFRESH_SECRET="change-me-refresh-secret-please"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="30d"

# --- Auth / SMS ---
# 'true' uses a mock SMS provider (logs the OTP) so auth is testable without
# a live +998 provider (Eskiz.uz / Play Mobile).
MOCK_SMS=true
# ESKIZ_EMAIL=
# ESKIZ_PASSWORD=

# --- S3-compatible storage (presigned URLs) ---
# S3_ENDPOINT=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET_PRINT_FILES=print-files
# S3_BUCKET_PUBLIC=public

# --- Payments (server verifies every callback signature) ---
PAYMENTS_SANDBOX=true
# CLICK_SECRET=
# PAYME_KEY=
# UZUM_KEY=
